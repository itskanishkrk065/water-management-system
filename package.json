{
  "name": "water-management-system",
  "version": "1.0.0",
  "description": "Kongu Basin Water Allocation, Development Billing, and Beneficiary Management System (Offline Desktop Application)",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run start:dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "build": "npm run build:all",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:all": "npm run build:backend && npm run build:frontend",
    "start": "concurrently \"npm run start:prod --prefix backend\" \"npm run start --prefix frontend\"",
    "start:backend": "npm run start:prod --prefix backend",
    "start:frontend": "npm run start --prefix frontend",
    "desktop:dev": "cross-env NODE_ENV=development electron .",
    "desktop:build": "npm run build:all",
    "desktop:package": "electron-builder --dir",
    "desktop:dmg": "npm run build && electron-builder --mac dmg",
    "desktop:installer": "npm run build && electron-builder --win nsis --x64",
    "desktop:installer:x64": "npm run build && electron-builder --win nsis --x64",
    "desktop:installer:all": "npm run build && electron-builder --win nsis --x64 --ia32"
  },
  "author": "WaterGrid Development Authority",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "in.gov.water.management",
    "productName": "WaterGrid",
    "executableName": "WaterManagement",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "asar": false,
    "files": [
      "electron/**/*",
      "build/**/*",
      "village_eng1.xls"
    ],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend/dist"
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "backend/package.json",
        "to": "backend/package.json"
      },
      {
        "from": "backend/prisma",
        "to": "backend/prisma"
      },
      {
        "from": "frontend/.next/standalone",
        "to": "frontend/.next/standalone"
      },
      {
        "from": "village_eng1.xls",
        "to": "village_eng1.xls"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "publisherName": "WaterGrid Development Authority",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WaterGrid",
      "uninstallDisplayName": "Uninstall WaterGrid",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0"
  }
}
